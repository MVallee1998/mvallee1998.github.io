 @article{Choi_Vallée_2022a,
 title={Cohomological Rigidity of the Connected Sum of Three Real Projective Spaces},
 volume={317},
 rights={All rights reserved},
 ISSN={0081-5438, 1531-8605},
 DOI={10.1134/S0081543822020109},
 number={1},
 fjournal={Proceedings of the Steklov Institute of Mathematics},
 journal={Proc. Steklov Inst. Math.},
 author={Suyoung Choi and Mathieu Vallée},
 abstract={A real toric manifold $X^\R$ is said to be cohomologically rigid over $\Z_2$ if every real toric manifold whose $\Z_2$-cohomology ring is isomorphic to the one of $X^\R$ is actually diffeomorphic to $X^\R$.
    Not all real toric manifolds are cohomologically rigid over $\Z_2$.
    In this paper, we prove that the connected sum of three real projective spaces is cohomologically rigid over $\Z_2$.},
 year={2022},
 month=jun,
 pages={178–188},
language={en} }

 @article{Choi_Vallée_2022b,
 title={An algorithmic strategy for finding characteristic maps over wedged simplicial complexes},
 volume={320},
 rights={All rights reserved},
 ISSN={1945-5844, 0030-8730},
 DOI={10.2140/pjm.2022.320.13},
 number={1},
 fjournal={Pacific Journal of Mathematics},
 journal={Pacific J. Math.},
 author={Suyoung Choi and Mathieu Vallée},
 abstract={The puzzle method was introduced by Choi and Park as an effective method for finding non-singular characteristic maps over wedged simplicial complexes $K(J)$ obtained from a given simplicial complex $K$. We study further the mod $2$ case of the puzzle method. We firstly describe it completely in terms of linear algebraic language which allows us to develop a constructive puzzle algorithm. We also analyze our algorithm and compare its performances with other known algorithms including the Garrison and Scott algorithm.},
 year={2022},
 month=oct,
 pages={13–43},
language={en} }

